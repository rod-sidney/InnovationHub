# Copia este archivo con el nombre .env. 
# Vite solo entrega al navegador las variables que empiezan con VITE_
# el archivo .env no se sube al repositorio

# Dirección de la API
VITE_API_URL=http://localhost:3000/api

# API pública de GitHub (información de los repositorios de los proyectos)
VITE_GITHUB_API_URL=https://api.github.com