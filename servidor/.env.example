# Copia este archivo con el nombre .env y ajusta los valores si hace falta.
# El archivo .env no se sube al repositorio (está en .gitignore).

# Puerto donde escucha la API
PORT=3000

# Cadena de conexión de MongoDB. La base "innovation-hub" se crea sola al cargar los datos.
MONGODB_URI=mongodb://127.0.0.1:27017/innovation-hub

# Origen del cliente React que puede llamar a la API desde el navegador (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Horas que dura una sesión antes de vencer
SESSION_HOURS=8